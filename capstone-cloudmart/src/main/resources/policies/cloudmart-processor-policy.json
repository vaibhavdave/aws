{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UpdateOrderStatus",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-east-1:000000000000:table/cloudmart-orders"
    },
    {
      "Sid": "ConsumeOrderProcessingQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:us-east-1:000000000000:cloudmart-order-processing-queue"
    }
  ]
}
