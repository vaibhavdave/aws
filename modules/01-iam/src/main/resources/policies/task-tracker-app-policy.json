{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TaskTrackerTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:000000000000:table/task-tracker",
        "arn:aws:dynamodb:us-east-1:000000000000:table/task-tracker/index/*"
      ]
    },
    {
      "Sid": "TaskTrackerFileVaultAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::task-tracker-files/*"
    }
  ]
}
